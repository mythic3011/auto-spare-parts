# Application Environment
# Use production on any shared host. X-Test-Env is ignored unless this is development or testing.
APP_ENV=development
APP_DEBUG=true

# Database Configuration
# mysqli | pdo_mysql | pdo_pgsql | pdo_sqlite
DB_DRIVER=mysqli
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=projectdb
DB_CHARSET=utf8mb4
# Request-scoped SELECT cache. Off when APP_ENV=testing unless this is set.
DB_QUERY_CACHE=true
DB_QUERY_CACHE_SIZE=64

# CORS preflight cache, in seconds
CORS_MAX_AGE=600

# Docker Database Configuration (used when DOCKER_ENV=true)
DB_DOCKER_HOST=mariadb
DB_DOCKER_USER=root
DB_DOCKER_PASSWORD=
DB_DOCKER_NAME=projectDB

# API Configuration
DEV_TOKEN=
API_BASE_URL=http://localhost

# Allowed Origins for CORS
ALLOWED_ORIGINS=http://localhost,https://example.com

# Turnstile Configuration
TURNSTILE_SECRET_KEY=THIS_IS_A_TURNSTILE_SECRET_KEY
TURNSTILE_ENABLED=false

# Shipping service origin; checkout fails if the service is unavailable.
SHIPPING_SERVICE_URL=http://api:8080

# Local Compose access (database and shipping stay internal).
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8880
PHPMYADMIN_PORT=8090
