{
  "name": "auto-spare-parts/portal",
  "description": "Auto Spare Part Management System",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.3",
    "vlucas/phpdotenv": "^5.6",
    "doctrine/orm": "^3.2",
    "doctrine/dbal": "^4.0",
    "doctrine/migrations": "^3.8",
    "symfony/cache": "^7.1"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "friendsofphp/php-cs-fixer": "^3.48",
    "phpunit/phpunit": "^11.0",
    "phpstan/phpstan-doctrine": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "App\\Api\\": "apps/api/src/"
    },
    "classmap": ["resources/php/class/"]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    },
    "exclude-from-classmap": ["/tests/Runtime/"]
  },
  "scripts": {
    "lint": "php-cs-fixer fix --dry-run --diff",
    "lint:fix": "php-cs-fixer fix",
    "analyze": "phpstan analyse",
    "test": "phpunit",
    "check:api-paths": "bash scripts/checks/check-hardcoded-api-paths.sh"
  },
  "config": {
    "platform": { "php": "8.3.0" },
    "allow-plugins": {
      "composer/installers": true
    }
  }
}
